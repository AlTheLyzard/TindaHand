# Public, development-only switch. Copy to .env.local and restart Metro.
# Use true only to enable the fictional Owner login described in README.md.
EXPO_PUBLIC_ENABLE_MOCK_AUTH=false

# Expo public variables are embedded in client bundles. Never put secrets here.

# Optional development-only Settings fixtures; restart Metro and reload to apply.
# EXPO_PUBLIC_SETTINGS_SCENARIO=offline
# Values: up-to-date, offline, failed, syncing (fixed 58% fixture), complete
# EXPO_PUBLIC_SETTINGS_EMPTY=true
# EXPO_PUBLIC_SETTINGS_FAIL_NEXT=sync
# Fail once: create, change-pin, reset-pin, sync, clear-cache

# Development-only cold-start PIN recovery links: valid, expired, used. No email is sent.
# EXPO_PUBLIC_MOCK_RECOVERY_SCENARIO=valid
# Production integration: owned HTTPS recovery origin (not yet supplied).
# EXPO_PUBLIC_RECOVERY_ORIGIN=https://your-owned-domain.example
