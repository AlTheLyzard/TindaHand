# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./tindahand.db

# ── JWT ───────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret
ALGORITHM=HS256

# ── Email (Gmail SMTP for PIN recovery) ───────────────────────────
# 1. Go to myaccount.google.com → Security → App passwords
# 2. Create an app password for "Mail"
# 3. Paste it below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# ── App URL (used in recovery email link) ─────────────────────────
# Set this to your machine's IP so the link opens in the app
APP_BASE_URL=http://192.168.254.103:8000
