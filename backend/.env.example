# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./tindahand.db

# ── JWT ───────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret
ALGORITHM=HS256

# ── Email (Gmail SMTP for PIN recovery) ───────────────────────────
# 1. Go to myaccount.google.com → Security → App passwords
# 2. Create an app password for "Mail"
# 3. Paste it below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# ── Recovery email deep link ───────────────────────────────────────
# Dev/local builds (default — no change needed):
#   APP_DEEP_LINK_BASE=tindahand:/
#   Email link becomes:  tindahand://reset-pin?token=<token>
#   The app opens reset-pin.tsx automatically on the device.
#
# Production (set to your HTTPS domain):
#   APP_DEEP_LINK_BASE=https://app.yourdomain.com
#   Then configure iOS Associated Domains + Android App Links in app.json.
APP_DEEP_LINK_BASE=tindahand:/
